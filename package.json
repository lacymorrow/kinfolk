{
  "name": "kinfolk",
  "version": "0.1.0",
  "homepage": "https://kinfolk.family",
  "repository": {
    "type": "git",
    "url": "https://github.com/lacymorrow/kinfolk"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --turbo",
    "build:vercel": "NODE_OPTIONS='--max-old-space-size=8192' next build --turbo",
    "clean": "rm -rf .next node_modules .turbo",
    "dev": "next dev --turbo",
    "dev:legacy": "next dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "dotenv -e .env -- tsx scripts/db-drop.ts",
    "db:reset": "npm run db:drop && npm run db:generate && npm run db:migrate && npm run db:push",
    "db:seed": "dotenv -e .env -- tsx scripts/db-seed.ts",
    "lint": "npm run lint:biome && npm run lint:eslint && npm run lint:prettier",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check \"**/*.{ts,tsx,md,mdx,json}\"",
    "lint:fix": "npm run lint:fix:biome && npm run lint:fix:eslint && npm run lint:fix:prettier",
    "lint:fix:biome": "biome check --write .",
    "lint:fix:eslint": "eslint --fix .",
    "lint:fix:prettier": "prettier --write \"**/*.{ts,tsx,md,mdx,json}\"",
    "start": "next start",
    "postinstall": "npx next telemetry disable",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build --turbo"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.1",
    "@formkit/auto-animate": "^0.9.0",
    "@hookform/resolvers": "5.2.2",
    "@mantine/hooks": "^8.3.14",
    "@next/env": "^16.1.6",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.95.3",
    "@t3-oss/env-nextjs": "0.13.10",
    "@tailwindcss/typography": "^0.5.19",
    "@uidotdev/usehooks": "2.4.1",
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-kit": "0.31.9",
    "drizzle-orm": "0.45.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.0",
    "geist": "1.7.0",
    "holy-loader": "2.3.14",
    "input-otp": "^1.4.2",
    "lint-staged": "16.2.7",
    "lucide-react": "0.564.0",
    "motion": "^12.34.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.29",
    "next-themes": "0.4.6",
    "next-view-transitions": "0.3.5",
    "nuqs": "^2.8.8",
    "picocolors": "1.1.1",
    "postgres": "3.4.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "7.71.1",
    "react-hotkeys-hook": "5.2.4",
    "react-page-tracker": "^0.5.0",
    "react-resizable-panels": "^4.6.4",
    "react-use-measure": "^2.1.7",
    "react-wrap-balancer": "^1.1.1",
    "server-only": "0.0.1",
    "sharp": "0.33.5",
    "sonner": "2.0.7",
    "superjson": "2.2.6",
    "tailwind-merge": "3.4.1",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.0",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "3.25.74",
    "zsa": "0.6.0",
    "zsa-react": "^0.2.3",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@eslint/eslintrc": "^3.3.3",
    "@next/bundle-analyzer": "16.1.6",
    "@next/eslint-plugin-next": "16.1.6",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.0.18",
    "autoprefixer": "10.4.24",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "3.4.17",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "oauth4webapi": "3.6.2"
    },
    "onlyBuiltDependencies": [
      "@vercel/speed-insights",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "trustedDependencies": [
    "@vercel/speed-insights",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
